# Copy to .env.local. For local Supabase, `bun run db:env` prints the first three values.

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (server only): Customer, Operator and cron functions
SUPABASE_SECRET_KEY=

# Web Push: generate once with `bunx web-push generate-vapid-keys`.
# Rotating these keys invalidates every existing subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com

# Operator admin API bearer key (server only)
OPERATOR_API_KEY=
# Bearer secret the Netlify scheduled function sends to the cron route (server only)
CRON_SECRET=

# Public base URL encoded in Shop QR codes. Never change it once codes are printed.
APP_BASE_URL=http://127.0.0.1:3000

# Sentry. Leave the DSN empty locally and nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload; skipped when the token is empty.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
